{
  "name": "duii.dev",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "media": "node --disable-warning=ExperimentalWarning scripts/media.ts",
    "contributions": "node --disable-warning=ExperimentalWarning scripts/github-contributions.ts",
    "api": "node --disable-warning=ExperimentalWarning scripts/build-api.ts",
    "prebuild": "npm run media && npm run contributions && npm run api",
    "build": "tsc -b && vite build && node --disable-warning=ExperimentalWarning scripts/prerender-blog.ts && node --disable-warning=ExperimentalWarning scripts/prerender-projects.ts",
    "server": "node --disable-warning=ExperimentalWarning server/index.ts",
    "lint": "eslint .",
    "check": "npm run lint && npm run build",
    "preview": "vite preview"
  },
  "dependencies": {
    "lenis": "^1.1.18",
    "lucide-react": "^1.18.0",
    "motion": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "ffmpeg-static": "^5.3.0",
    "globals": "^17.6.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.1",
    "pdf-to-img": "^7.0.2",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
}
